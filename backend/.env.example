# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# ---- docker-compose only ----
# Required by docker-compose.yml (db + backend DATABASE_URL). No default.
POSTGRES_PASSWORD=

# ---- Database (PostgreSQL) ----
# Any PostgreSQL instance: self-hosted, docker-compose (see docker-compose.yml),
# or a managed provider. Example:
#   postgres://kyc:kyc@localhost:5432/kyc
DATABASE_URL=

# ---- Optional ----
# Extra CORS origins (comma-separated), e.g. the frontend URL when it is
# served from a different origin than the API.
CORS_ALLOWED_ORIGINS=
# Set to false when TLS terminates at a reverse proxy that already forces
# HTTPS (default: true when DJANGO_DEBUG=false).
#DJANGO_SECURE_SSL_REDIRECT=false
