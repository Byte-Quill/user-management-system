# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# ---- docker-compose only ----
# Required by docker-compose.yml; no default.
POSTGRES_PASSWORD=

# ---- Database (PostgreSQL) ----
# Any PostgreSQL instance; example: postgres://kyc:kyc@localhost:5432/kyc
DATABASE_URL=

# ---- Optional ----
# Extra CORS origins (comma-separated) for split-origin frontends.
CORS_ALLOWED_ORIGINS=
# Set to false when TLS terminates at a reverse proxy that already forces
# HTTPS (default: true when DJANGO_DEBUG=false).
#DJANGO_SECURE_SSL_REDIRECT=false
